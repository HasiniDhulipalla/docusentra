# Local development defaults only. start-trustvault.ps1 generates a random TOKEN_SECRET.
APP_ENV=development
POSTGRES_PASSWORD=trustvault_local_change_me
TOKEN_SECRET=
# Keep this key stable; changing it requires a planned audit-chain key-rotation procedure.
AUDIT_HMAC_SECRET=
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# Optional seed account overrides. Local mode uses development-only sample credentials if left blank.
# Production mode requires all SEED_* values before running `python -m app.seed`.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OWNER_USERNAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_VIEWER_USERNAME=
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=
# Production: use unique credentials, APP_ENV=production, HTTPS, and follow DEPLOYMENT.md.

# Break-glass local recovery only: archive unverifiable audit history after backup. Leave blank normally.
TRUSTVAULT_AUDIT_RECOVERY=
