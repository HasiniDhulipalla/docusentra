# Single-project Vercel Services deployment routes /api/* to FastAPI on the same origin.
# Leave VITE_API_BASE_URL unset in Vercel. If it was previously set to the deleted backend project, remove it.
# For split local dev servers only, set VITE_API_BASE_URL=http://127.0.0.1:8000.
# Vercel Functions impose a 4.5 MB request/response body limit; use 3800000 bytes for cloud deployment.
VITE_MAX_UPLOAD_BYTES=3800000
