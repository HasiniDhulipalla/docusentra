# Local development only. For Vercel, configure these in the Vercel project's Environment Variables.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://trustvault:change-this-db-password@localhost:5432/trustvault
STORAGE_DIR=./private_storage
STORAGE_BACKEND=filesystem
TOKEN_SECRET=replace-this-with-a-random-secret-at-least-32-characters
AUDIT_HMAC_SECRET=replace-this-with-a-separate-stable-audit-key-at-least-32-characters
TOKEN_TTL_SECONDS=28800
MAX_UPLOAD_BYTES=15728640
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
LOGIN_MAX_FAILURES=10
LOGIN_RATE_WINDOW_SECONDS=300
REGISTER_MAX_ATTEMPTS=10
REGISTER_RATE_WINDOW_SECONDS=3600
# For Vercel deployment, set STORAGE_BACKEND=vercel_blob and MAX_UPLOAD_BYTES=3800000.
# Connect a private Vercel Blob store to the backend project; do not put Blob credentials in frontend env vars.
